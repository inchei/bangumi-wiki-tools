staff_multi_person_all	WITH subjects AS (SELECT * FROM read_json_auto('$DATA_DIR/subject.jsonlines', format='newline_delimited')),
persons AS (SELECT id as person_id, name, type as person_type, career, COALESCE(infobox,'') as infobox, summary, collects, comments FROM read_json_auto('$DATA_DIR/person.jsonlines', format='newline_delimited')),
subject_persons AS (SELECT * FROM read_json_auto('$DATA_DIR/subject-persons.jsonlines', format='newline_delimited'))
SELECT p."person_id", p."name"
FROM persons p
WHERE EXISTS (SELECT 1 FROM subject_persons sp1 JOIN subject_persons sp2 ON sp2.person_id = sp1.person_id AND sp2.subject_id = sp1.subject_id WHERE sp1.person_id = p.person_id AND sp1.position IN (1, 1015, 2007, 3005, 4001) AND sp2.position IN (3, 2010, 3010)) AND
 (SELECT COUNT(DISTINCT sp1.subject_id) FROM subject_persons sp1 JOIN subject_persons sp2 ON sp2.person_id = sp1.person_id AND sp2.subject_id = sp1.subject_id WHERE sp1.person_id = p.person_id AND sp1.position IN (1, 1015, 2007, 3005, 4001) AND sp2.position IN (3, 2010, 3010)) =
 (SELECT COUNT(DISTINCT sp1.subject_id) FROM subject_persons sp1 JOIN subject_persons sp2 ON sp2.person_id = sp1.person_id AND sp2.subject_id = sp1.subject_id WHERE sp1.person_id = p.person_id AND sp1.position IN (1, 1015, 2007, 3005, 4001) AND sp2.position IN (3, 2010, 3010))
LIMIT 10
