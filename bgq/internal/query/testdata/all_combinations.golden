person_staff_group_json	WITH subjects AS (SELECT * FROM read_json_auto('$DATA_DIR/subject.jsonlines', format='newline_delimited')),
persons AS (SELECT id as person_id, name, type as person_type, career, COALESCE(infobox,'') as infobox, summary, collects, comments FROM read_json_auto('$DATA_DIR/person.jsonlines', format='newline_delimited')),
subject_persons AS (SELECT * FROM read_json_auto('$DATA_DIR/subject-persons.jsonlines', format='newline_delimited'))
SELECT p."person_id", p."name", (SELECT to_json(list(_r._s)) FROM (SELECT struct_pack("name" := NULLIF(CAST(rs."name" AS VARCHAR), ''), "rank" := NULLIF(CAST(rs."rank" AS VARCHAR), ''), "id" := NULLIF(CAST(rs.id AS VARCHAR), '')) AS _s FROM subject_persons sp LEFT JOIN subjects rs ON sp.subject_id = rs.id WHERE sp.person_id = p.person_id AND sp.position IN (10, 1027) AND rs."rank" != 0 AND CAST(rs."rank" AS DOUBLE) < 1500 ORDER BY rs.id ASC LIMIT 1) _r) AS "系列构成.{name|rank|id}"
FROM persons p
WHERE EXISTS (SELECT 1 FROM subject_persons subject_persons LEFT JOIN subjects rs ON subject_persons.subject_id = rs.id WHERE subject_persons.person_id = p.person_id AND subject_persons.position IN (10, 1027) AND rs."rank" != 0 AND CAST(rs."rank" AS DOUBLE) < 1500)
LIMIT 10
person_staff_output	WITH subjects AS (SELECT * FROM read_json_auto('$DATA_DIR/subject.jsonlines', format='newline_delimited')),
persons AS (SELECT id as person_id, name, type as person_type, career, COALESCE(infobox,'') as infobox, summary, collects, comments FROM read_json_auto('$DATA_DIR/person.jsonlines', format='newline_delimited')),
subject_persons AS (SELECT * FROM read_json_auto('$DATA_DIR/subject-persons.jsonlines', format='newline_delimited'))
SELECT p."person_id", p."name", (SELECT string_agg(CAST(t."_v" AS VARCHAR), ', ' ORDER BY t."_ord") FROM (SELECT rs."name" AS "_v", rs.id AS "_ord" FROM subject_persons sp LEFT JOIN subjects rs ON sp.subject_id = rs.id WHERE sp.person_id = p.person_id AND sp.position IN (10, 1027) AND rs."rank" != 0 AND CAST(rs."rank" AS DOUBLE) < 1500 ORDER BY rs.id LIMIT 1) t) AS "系列构成.name"
FROM persons p
WHERE EXISTS (SELECT 1 FROM subject_persons subject_persons LEFT JOIN subjects rs ON subject_persons.subject_id = rs.id WHERE subject_persons.person_id = p.person_id AND subject_persons.position IN (10, 1027) AND rs."rank" != 0 AND CAST(rs."rank" AS DOUBLE) < 1500)
LIMIT 10
relation_output	WITH subjects AS (SELECT * FROM read_json_auto('$DATA_DIR/subject.jsonlines', format='newline_delimited')),
subject_relations AS (SELECT * FROM read_json_auto('$DATA_DIR/subject-relations.jsonlines', format='newline_delimited'))
SELECT s."id", s."name", (SELECT string_agg(CAST(t."_v" AS VARCHAR), ', ' ORDER BY t."_ord") FROM (SELECT rs."name" AS "_v", rs.id AS "_ord" FROM subject_relations r LEFT JOIN subjects rs ON r.related_subject_id = rs.id WHERE r.subject_id = s.id AND r.relation_type IN (1003) AND CAST(rs."name" AS VARCHAR) LIKE '%1%' ESCAPE '\' ORDER BY rs.id LIMIT 1) t) AS "单行本.name", (SELECT string_agg(CAST(t."_v" AS VARCHAR), ', ' ORDER BY t."_ord") FROM (SELECT regexp_extract(rs.infobox, '(?i)\|发售日\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1) AS "_v", rs.id AS "_ord" FROM subject_relations r LEFT JOIN subjects rs ON r.related_subject_id = rs.id WHERE r.subject_id = s.id AND r.relation_type IN (1003) AND CAST(rs."name" AS VARCHAR) LIKE '%1%' ESCAPE '\' ORDER BY rs.id LIMIT 1) t) AS "单行本.发售日"
FROM subjects s
WHERE EXISTS (SELECT 1 FROM subject_relations r LEFT JOIN subjects rs ON r.related_subject_id = rs.id WHERE r.subject_id = s.id AND r.relation_type IN (1003) AND CAST(rs."name" AS VARCHAR) LIKE '%1%' ESCAPE '\')
LIMIT 10
relation_output_count	WITH subjects AS (SELECT * FROM read_json_auto('$DATA_DIR/subject.jsonlines', format='newline_delimited')),
subject_relations AS (SELECT * FROM read_json_auto('$DATA_DIR/subject-relations.jsonlines', format='newline_delimited'))
SELECT s."id", s."name", (SELECT COUNT(*) FROM subject_relations r LEFT JOIN subjects rs ON r.related_subject_id = rs.id WHERE r.subject_id = s.id AND r.relation_type IN (1003) AND CAST(rs."name" AS VARCHAR) LIKE '%1%' ESCAPE '\') AS "单行本.count"
FROM subjects s
WHERE EXISTS (SELECT 1 FROM subject_relations r LEFT JOIN subjects rs ON r.related_subject_id = rs.id WHERE r.subject_id = s.id AND r.relation_type IN (1003) AND CAST(rs."name" AS VARCHAR) LIKE '%1%' ESCAPE '\')
LIMIT 10
relation_subject_all	WITH subjects AS (SELECT * FROM read_json_auto('$DATA_DIR/subject.jsonlines', format='newline_delimited')),
subject_relations AS (SELECT * FROM read_json_auto('$DATA_DIR/subject-relations.jsonlines', format='newline_delimited'))
SELECT s."id", s."name"
FROM subjects s
WHERE EXISTS (SELECT 1 FROM subject_relations r WHERE r.subject_id = s.id AND r.relation_type IN (1003)) AND
 (SELECT COUNT(*) FROM subject_relations r LEFT JOIN subjects rs ON r.related_subject_id = rs.id WHERE r.subject_id = s.id AND r.relation_type IN (1003) AND CAST(rs."score" AS DOUBLE) > 8) =
 (SELECT COUNT(*) FROM subject_relations r WHERE r.subject_id = s.id AND r.relation_type IN (1003))
LIMIT 10
