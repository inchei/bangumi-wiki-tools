character_person_group_subject_fields	WITH subjects AS (SELECT * FROM read_json_auto('$DATA_DIR/subject.jsonlines', format='newline_delimited')),
characters AS (SELECT id as character_id, role, name, COALESCE(infobox,'') as infobox, summary, comments, collects FROM read_json_auto('$DATA_DIR/character.jsonlines', format='newline_delimited')),
person_characters AS (SELECT * FROM read_json_auto('$DATA_DIR/person-characters.jsonlines', format='newline_delimited')),
persons AS (SELECT id as person_id, name, type as person_type, career, COALESCE(infobox,'') as infobox, summary, collects, comments FROM read_json_auto('$DATA_DIR/person.jsonlines', format='newline_delimited'))
SELECT c."character_id", c."name", (SELECT to_json(list(_r._s)) FROM (SELECT struct_pack("id" := NULLIF(CAST(p.person_id AS VARCHAR), ''), "name" := NULLIF(CAST(p."name" AS VARCHAR), ''), "s.id" := NULLIF(CAST(rs.id AS VARCHAR), ''), "s.name" := NULLIF(CAST(rs."name" AS VARCHAR), '')) AS _s FROM person_characters pc LEFT JOIN persons p ON pc.person_id = p.person_id LEFT JOIN subjects rs ON pc.subject_id = rs.id WHERE pc.character_id = c.character_id AND pc.type = 0 ORDER BY p.person_id ASC LIMIT 1) _r) AS "CV.{id|name|s.id|s.name}"
FROM characters c
WHERE EXISTS (SELECT 1 FROM person_characters pc WHERE pc.character_id = c.character_id AND pc.type = 0)
LIMIT 10
character_person_output	WITH subjects AS (SELECT * FROM read_json_auto('$DATA_DIR/subject.jsonlines', format='newline_delimited')),
characters AS (SELECT id as character_id, role, name, COALESCE(infobox,'') as infobox, summary, comments, collects FROM read_json_auto('$DATA_DIR/character.jsonlines', format='newline_delimited')),
person_characters AS (SELECT * FROM read_json_auto('$DATA_DIR/person-characters.jsonlines', format='newline_delimited')),
persons AS (SELECT id as person_id, name, type as person_type, career, COALESCE(infobox,'') as infobox, summary, collects, comments FROM read_json_auto('$DATA_DIR/person.jsonlines', format='newline_delimited'))
SELECT c."character_id", c."name", (SELECT string_agg(CAST("agg"."_v" AS VARCHAR), ', ' ORDER BY "agg"."person_id") FROM (SELECT DISTINCT p.person_id AS "person_id", p."name" AS "_v" FROM person_characters pc LEFT JOIN persons p ON pc.person_id = p.person_id WHERE pc.character_id = c.character_id AND pc.type = 0 ORDER BY p.person_id LIMIT 1) "agg") AS "CV.name"
FROM characters c
WHERE EXISTS (SELECT 1 FROM person_characters pc WHERE pc.character_id = c.character_id AND pc.type = 0)
LIMIT 10
character_person_subject_output	WITH subjects AS (SELECT * FROM read_json_auto('$DATA_DIR/subject.jsonlines', format='newline_delimited')),
characters AS (SELECT id as character_id, role, name, COALESCE(infobox,'') as infobox, summary, comments, collects FROM read_json_auto('$DATA_DIR/character.jsonlines', format='newline_delimited')),
person_characters AS (SELECT * FROM read_json_auto('$DATA_DIR/person-characters.jsonlines', format='newline_delimited')),
persons AS (SELECT id as person_id, name, type as person_type, career, COALESCE(infobox,'') as infobox, summary, collects, comments FROM read_json_auto('$DATA_DIR/person.jsonlines', format='newline_delimited'))
SELECT c."character_id", c."name", (SELECT string_agg(CAST("agg"."_v" AS VARCHAR), ', ' ORDER BY "agg"."id") FROM (SELECT DISTINCT rs.id AS "id", rs."name" AS "_v" FROM person_characters pc LEFT JOIN subjects rs ON pc.subject_id = rs.id LEFT JOIN persons p ON pc.person_id = p.person_id WHERE pc.character_id = c.character_id AND pc.type = 0 AND CAST(p.name AS VARCHAR) LIKE '%水树%' ESCAPE '\' AND rs."rank" != 0 AND CAST(rs."rank" AS DOUBLE) < 5000 ORDER BY rs.id LIMIT 1) "agg") AS "CV.s.name"
FROM characters c
WHERE EXISTS (SELECT 1 FROM person_characters pc LEFT JOIN persons p ON pc.person_id = p.person_id LEFT JOIN subjects rs ON pc.subject_id = rs.id
			 WHERE pc.character_id = c.character_id AND pc.type = 0 AND CAST(p.name AS VARCHAR) LIKE '%水树%' ESCAPE '\' AND rs."rank" != 0 AND CAST(rs."rank" AS DOUBLE) < 5000)
LIMIT 10
character_relation_character_all	WITH subjects AS (SELECT * FROM read_json_auto('$DATA_DIR/subject.jsonlines', format='newline_delimited')),
characters AS (SELECT id as character_id, role, name, COALESCE(infobox,'') as infobox, summary, comments, collects FROM read_json_auto('$DATA_DIR/character.jsonlines', format='newline_delimited')),
character_relations AS (SELECT * FROM read_json_auto('$DATA_DIR/person-relations.jsonlines', format='newline_delimited') WHERE person_type = 'crt')
SELECT c."character_id", c."name"
FROM characters c
WHERE EXISTS (SELECT 1 FROM character_relations cr WHERE cr.person_id = c.character_id AND cr.relation_type IN (2002)) AND
 (SELECT COUNT(*) FROM character_relations cr  WHERE cr.person_id = c.character_id AND cr.relation_type IN (2002)) =
 (SELECT COUNT(*) FROM character_relations cr WHERE cr.person_id = c.character_id AND cr.relation_type IN (2002))
LIMIT 10
