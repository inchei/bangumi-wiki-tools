episodes AS (SELECT id AS episode_id, * EXCLUDE (id) FROM read_json_auto('$DATA_DIR/episode.jsonlines', format='newline_delimited'))
SELECT s."id", s."name", (SELECT string_agg(CAST(t."_v" AS VARCHAR), ', ' ORDER BY t."_ord") FROM (SELECT e."name" AS "_v", e.episode_id AS "_ord" FROM episodes e  WHERE e.subject_id = s.id AND TRUE AND CAST(e."name" AS VARCHAR) LIKE '%test%' ESCAPE '\' ORDER BY e.episode_id LIMIT 1) t) AS "episode.name", (SELECT COUNT(*) FROM episodes e  WHERE e.subject_id = s.id AND TRUE AND CAST(e."name" AS VARCHAR) LIKE '%test%' ESCAPE '\') AS "episode.count"
FROM subjects s
WHERE EXISTS (SELECT 1 FROM episodes e WHERE e.subject_id = s.id AND CAST(e."name" AS VARCHAR) LIKE '%test%' ESCAPE '\')
