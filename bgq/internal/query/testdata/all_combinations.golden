field_ref	WITH subjects AS (SELECT * FROM read_json_auto('$DATA_DIR/subject.jsonlines', format='newline_delimited'))
SELECT s."id", s."name"
FROM subjects s
WHERE TRY_CAST(CASE WHEN regexp_matches(replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|发售日\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', ''), '^\d{4}$') THEN replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|发售日\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', '') || '-01-01' WHEN regexp_matches(replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|发售日\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', ''), '^\d{4}-\d{1,2}$') THEN replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|发售日\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', '') || '-01' ELSE replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|发售日\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', '') END AS DATE) < TRY_CAST(CASE WHEN regexp_matches(replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|连载开始\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', ''), '^\d{4}$') THEN replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|连载开始\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', '') || '-01-01' WHEN regexp_matches(replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|连载开始\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', ''), '^\d{4}-\d{1,2}$') THEN replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|连载开始\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', '') || '-01' ELSE replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|连载开始\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', '') END AS DATE)
LIMIT 10
field_ref_mod	WITH subjects AS (SELECT * FROM read_json_auto('$DATA_DIR/subject.jsonlines', format='newline_delimited'))
SELECT s."id", s."name"
FROM subjects s
WHERE TRY_CAST(CASE WHEN regexp_matches(replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|发售日\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', ''), '^\d{4}$') THEN replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|发售日\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', '') || '-01-01' WHEN regexp_matches(replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|发售日\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', ''), '^\d{4}-\d{1,2}$') THEN replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|发售日\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', '') || '-01' ELSE replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|发售日\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', '') END AS DATE) > (TRY_CAST(CASE WHEN regexp_matches(replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|连载开始\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', ''), '^\d{4}$') THEN replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|连载开始\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', '') || '-01-01' WHEN regexp_matches(replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|连载开始\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', ''), '^\d{4}-\d{1,2}$') THEN replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|连载开始\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', '') || '-01' ELSE replace(replace(replace(TRIM(regexp_extract(regexp_extract(s.infobox, '(?i)\|连载开始\s*[:=]\s*(\{(?:[^}]|\n)*\}|[^|}\n\r]*)', 1), '(\d{4}(?:[-年]\d{1,2}(?:[-月]\d{1,2})?)?)', 1)), '年', '-'), '月', '-'), '日', '') END AS DATE) +300)
LIMIT 10
