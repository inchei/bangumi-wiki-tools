person_character_subject_output	WITH subjects AS (SELECT * FROM read_json_auto('$DATA_DIR/subject.jsonlines', format='newline_delimited')),
persons AS (SELECT id as person_id, name, type as person_type, career, COALESCE(infobox,'') as infobox, summary, collects, comments FROM read_json_auto('$DATA_DIR/person.jsonlines', format='newline_delimited')),
person_characters AS (SELECT * FROM read_json_auto('$DATA_DIR/person-characters.jsonlines', format='newline_delimited')),
characters AS (SELECT id as character_id, role, name, COALESCE(infobox,'') as infobox, summary, comments, collects FROM read_json_auto('$DATA_DIR/character.jsonlines', format='newline_delimited'))
SELECT p."person_id", p."name", (SELECT string_agg(CAST("agg"."_v" AS VARCHAR), ', ' ORDER BY "agg"."id") FROM (SELECT DISTINCT rs.id AS "id", rs."name" AS "_v" FROM person_characters pc LEFT JOIN subjects rs ON pc.subject_id = rs.id LEFT JOIN characters c ON pc.character_id = c.character_id WHERE pc.person_id = p.person_id AND pc.type = 0 AND CAST(c.name AS VARCHAR) LIKE '%アル%' ESCAPE '\' AND rs."rank" != 0 AND CAST(rs."rank" AS DOUBLE) < 5000 ORDER BY rs.id LIMIT 1) "agg") AS "CV.s.name"
FROM persons p
WHERE EXISTS (SELECT 1 FROM person_characters pc LEFT JOIN characters c ON pc.character_id = c.character_id LEFT JOIN subjects rs ON pc.subject_id = rs.id
			 WHERE pc.person_id = p.person_id AND pc.type = 0 AND CAST(c.name AS VARCHAR) LIKE '%アル%' ESCAPE '\' AND rs."rank" != 0 AND CAST(rs."rank" AS DOUBLE) < 5000)
LIMIT 10
person_relation_output	WITH subjects AS (SELECT * FROM read_json_auto('$DATA_DIR/subject.jsonlines', format='newline_delimited')),
persons AS (SELECT id as person_id, name, type as person_type, career, COALESCE(infobox,'') as infobox, summary, collects, comments FROM read_json_auto('$DATA_DIR/person.jsonlines', format='newline_delimited')),
person_relations AS (SELECT * FROM read_json_auto('$DATA_DIR/person-relations.jsonlines', format='newline_delimited') WHERE person_type = 'prsn')
SELECT p."person_id", p."name", (SELECT string_agg(CAST(t."_v" AS VARCHAR), ', ' ORDER BY t."_ord") FROM (SELECT rp."name" AS "_v", rp.person_id AS "_ord" FROM person_relations pr LEFT JOIN persons rp ON pr.related_person_id = rp.person_id WHERE pr.person_id = p.person_id AND pr.relation_type IN (1015) ORDER BY rp.person_id LIMIT 1) t) AS "同事.name", (SELECT COUNT(*) FROM person_relations pr LEFT JOIN persons rp ON pr.related_person_id = rp.person_id WHERE pr.person_id = p.person_id AND pr.relation_type IN (1015)) AS "同事.count"
FROM persons p
WHERE EXISTS (SELECT 1 FROM person_relations pr  WHERE pr.person_id = p.person_id AND pr.relation_type IN (1015))
LIMIT 10
