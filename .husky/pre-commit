#!/bin/bash

# Version bump strategy: interactive per-commit prompt.
# For each userscript with staged source changes, ask the level:
#   Enter = patch, m = minor, M = major, s = skip (no bump)
# Interactive detection uses stderr ([ -t 2 ]): git redirects hook stdin to
# /dev/null, so read must go through /dev/tty. Non-TTY (CI / GUI commits):
# fall back to skip (no auto bump).

bump_version() {
  file="$1"
  level="$2"
  old_version=$(grep -o '@version\s\+[0-9.]\+' "$file" | awk '{print $2}')
  if [ -z "$old_version" ]; then
    echo "  ⚠ $file: @version not found, skip bump"
    return 1
  fi
  IFS='.' read -ra parts <<< "$old_version"
  n=${#parts[@]}
  case "$level" in
    patch)
      parts[$((n - 1))]=$((parts[n - 1] + 1))
      ;;
    minor)
      if [ "$n" -ge 2 ]; then
        parts[$((n - 2))]=$((parts[n - 2] + 1))
        parts[$((n - 1))]=0
      else
        parts[0]=$((parts[0] + 1))
      fi
      ;;
    major)
      parts[0]=$((parts[0] + 1))
      for ((i = 1; i < n; i++)); do parts[$i]=0; done
      ;;
  esac
  new_version=$(IFS='.'; echo "${parts[*]}")
  if [ "$OSTYPE" = "darwin"* ]; then
    sed -i '' "s/@version\s\+$old_version/@version      $new_version/" "$file"
  else
    sed -i "s/@version\s\+$old_version/@version      $new_version/" "$file"
  fi
  echo "  🔖 $file: $old_version → $new_version"
}

prompt_bump() {
  file="$1"
  label="$2"
  cur=$(grep -o '@version\s\+[0-9.]\+' "$file" | awk '{print $2}')
  if [ -z "$cur" ]; then
    echo "  ⚠ $file: @version not found, skip bump" >&2
    echo skip
    return 1
  fi
  echo "  🔖 $label: current v$cur" >&2
  while true; do
    printf '     bump level? [Enter=patch, m=minor, M=major, s=skip]: ' >&2
    read -r choice < /dev/tty || { echo skip; return 0; }
    case "$choice" in
      '' | p | patch) echo patch; return 0 ;;
      m | minor) echo minor; return 0 ;;
      M | major) echo major; return 0 ;;
      s | skip | n | no) echo skip; return 0 ;;
      *) echo '     (invalid choice, try again)' >&2 ;;
    esac
  done
}

maybe_bump() {
  file="$1"
  label="$2"
  if [ -t 2 ]; then
    level=$(prompt_bump "$file" "$label")
  else
    level=skip
  fi
  [ "$level" != "skip" ] && bump_version "$file" "$level"
}

GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
FE_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^bgq/frontend/src/' || true)
MP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^userscripts/wikiMissingPositions/src/' || true)
ESR_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^userscripts/wikiEpStaffRelate/src/' || true)
PA_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^userscripts/wikiPersonAlias/' || true)
WB_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^userscripts/wikiBatch/src/' || true)

if [ -n "$GO_FILES" ]; then
  gofmt -w $GO_FILES
  git add $GO_FILES
  cd bgq && go vet ./... 2>&1 || exit 1
  go tool golangci-lint run ./... 2>&1 || exit 1
  go tool deadcode ./... 2>&1 || exit 1
  go test ./internal/query/ -run 'Test[^E]' 2>&1 || exit 1
  cd ..
fi

if [ -n "$FE_FILES" ]; then
  cd bgq/frontend || exit 1
  pnpm exec lint-staged || exit 1
  pnpm exec knip || exit 1
  cd ../..
fi

if [ -n "$MP_FILES" ]; then
  maybe_bump userscripts/wikiMissingPositions/header.js "wikiMissingPositions"
  cd userscripts/wikiMissingPositions
  if ! (pnpm lint && pnpm lint:css && pnpm format && pnpm format:check && pnpm build); then
    cd ../..
    git checkout -- userscripts/wikiMissingPositions/header.js
    exit 1
  fi
  cd ../..
  git add userscripts/wikiMissingPositions/src/ userscripts/wikiMissingPositions/header.js userscripts/wikiMissingPositions/dist/wikiMissingPositions.user.js
fi

if [ -n "$ESR_FILES" ]; then
  maybe_bump userscripts/wikiEpStaffRelate/header.js "wikiEpStaffRelate"
  cd userscripts/wikiEpStaffRelate
  if ! (pnpm lint && pnpm format && pnpm format:check && pnpm build); then
    cd ../..
    git checkout -- userscripts/wikiEpStaffRelate/header.js
    exit 1
  fi
  cd ../..
  git add userscripts/wikiEpStaffRelate/src/ userscripts/wikiEpStaffRelate/header.js userscripts/wikiEpStaffRelate/dist/wikiEpStaffRelate.user.js
fi

if [ -n "$PA_FILES" ]; then
  maybe_bump userscripts/wikiPersonAlias/wikiPersonAlias.user.js "wikiPersonAlias"
  cd userscripts/wikiPersonAlias
  if ! (pnpm lint && pnpm format && pnpm format:check); then
    cd ../..
    git checkout -- userscripts/wikiPersonAlias/wikiPersonAlias.user.js
    exit 1
  fi
  cd ../..
  git add userscripts/wikiPersonAlias/
fi

if [ -n "$WB_FILES" ]; then
  maybe_bump userscripts/wikiBatch/header.js "wikiBatch"
  cd userscripts/wikiBatch
  if ! (pnpm lint && pnpm lint:css && pnpm typecheck && pnpm build); then
    cd ../..
    git checkout -- userscripts/wikiBatch/header.js
    exit 1
  fi
  cd ../..
  git add userscripts/wikiBatch/header.js userscripts/wikiBatch/dist/wikiBatch.user.js
fi
